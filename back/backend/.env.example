# ─── Shadow Cheats Backend — .env.example ───
# Скопируй в .env и заполни реальными значениями
# Автогенерация через: ./deploy.sh

NODE_ENV=production
PORT=3001
# Optional isolated database path for integration tests.
# SHADOW_DB_PATH=C:\temp\shadow-test.db

# JWT подпись токенов (64 random bytes hex)
# Генерация: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_64BYTES_HEX

# HMAC подпись запросов лоадера
# ОБЯЗАТЕЛЬНО вшить в лоадер: network.hpp → CLIENT_SECRET (XOR-обфусцировать!)
# Генерация: openssl rand -hex 32
CLIENT_SHARED_SECRET=REPLACE_WITH_RANDOM_32BYTES_HEX

# 9.1: Master-ключ шифрования session_key_hex в БД (AES-256-GCM at rest)
# ОБЯЗАТЕЛЬНО — без этого сервер не запустится.
# Генерация: openssl rand -hex 32
SESSION_KEY_MASTER_SECRET=REPLACE_WITH_RANDOM_32BYTES_HEX

# HMAC-ключ персонального customer tag в защищённом payload.
# Генерация: openssl rand -hex 32
WATERMARK_SECRET=REPLACE_WITH_RANDOM_32BYTES_HEX
RAGEMP_VARIANT_COUNT=32

# CORS — разрешённый origin
ALLOWED_ORIGIN=https://shadowcheats.cc

# 8.1: Admin аккаунт (создаётся только если не существует)
# Минимум 12 символов. Слабый пароль = сервер не запустится.
ADMIN_USERNAME=YOUR_ADMIN_LOGIN
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_12CHARS_MIN

# 2.1: Master-ключ шифрования driver.sys на сервере (AES-256-GCM at rest)
# driver.sys шифруется этим ключом → сохраняется как drivers/<product_id>/driver.enc
# При каждом запросе сервер расшифровывает мастер-ключом и перешифровывает session_key юзера.
# Генерация: openssl rand -hex 32
# Зашифровать driver: node scripts/encrypt_driver.js ./driver.sys rage
DRIVER_MASTER_KEY=REPLACE_WITH_RANDOM_32BYTES_HEX
